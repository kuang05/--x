    text applied_version_id FK "应用后产生的版本"
    time created_at "创建时间"
  }
  connectivity_check {
    text id PK "检查 ID"
    text project_id FK "所属工程"
    text scope "检查阶段"
    text version_id FK "被检设计版本"
