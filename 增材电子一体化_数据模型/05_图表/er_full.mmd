    text net_id FK "所属网络"
    int layer_no "层号"
    hash geometry_blob_hash FK "轮廓多边形（CAS）"
    int priority "优先级"
    bool filled "已填充"
    time created_at "创建时间"
  }
  via {
    text id PK "过孔 ID"
    text circuit_id FK "所属电路"
    text net_id FK "所属网络"
    real x_mm "位置 X（mm）"
    real y_mm "位置 Y（mm）"
    real diameter_mm "外径（mm）"
    real drill_mm "钻孔直径（mm）"
