    hash input_digest "输入摘要（几何+参数）"
    time ran_at "检查时间"
  }
  mrc_rule_version {
    text id PK "规则版本 ID"
    text label "版本标签（如 v1 首版基线）"
    text note "变更说明"
    text created_by "创建者"
    text supersedes_id FK "被替代的上一版"
    hash snapshot_hash "阈值集合摘要（重放可比性）"
    bool is_active "是否当前生效"
    time created_at "生效时间"
  }
  mrc_rule_threshold {
    text rule_version_id FK "所属规则版本"
    text rule_code "规则码"
    text param_key "参数名"
    real value_num "阈值数值"
    text unit "单位"
    bool enabled "是否启用"
    text note "说明"
  }
  tool_geometry {
    text id PK "工具几何 ID"
    text name "名称（如 0.25 针头）"
    real nozzle_inner_d_mm "针头内径（mm）"
    real nozzle_outer_d_mm "针尖外径（mm）"
    real safety_gap_mm "安全间隙（mm）"
    json envelope_json "喷头包络（多段圆柱/包围盒）"
