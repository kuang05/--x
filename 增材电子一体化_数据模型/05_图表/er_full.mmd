    int to_layer "目标层号"
    time created_at "创建时间"
  }
  layout_candidate {
    text id PK "候选 ID"
    text circuit_id FK "所属电路"
    int rank_no "排序位次（1 最优）"
    real score "可打性分（0–100）"
    real wire_len_mm "飞线总长（mm）"
