erDiagram
  %% 增材电子一体化软件 · 字段级 ER（由 schema/ 生成，勿手改）

  project {
    text id PK "工程 ID（UUIDv7）"
    text name "工程名称"
    text unit "显示单位"
    real sheet_w_mm "幅面宽（mm）"
    real sheet_h_mm "幅面高（mm）"
    text origin_kind "坐标原点定义"
    real origin_x_mm "自定义原点 X（mm）"
    real origin_y_mm "自定义原点 Y（mm）"
    int data_schema_version "数据模式版本号"
    text current_version_id FK "当前版本（指向 version.id）"
    text dir_rel_path "工程目录（相对数据根）"
    text package_origin_id "工程包来源标识"
    time deleted_at "回收站删除时间"
    time created_at "创建时间"
    time updated_at "最后修改时间"
  }
  version {
    text id PK "版本 ID（UUIDv7）"
    text project_id FK "所属工程"
    int version_no "工程内版本号（从 0 递增）"
    text parent_version_id FK "父版本"
    text kind "版本产生方式"
    text author_kind "作者类型"
    text author_name "作者标识"
    text reason "修改原因（用户可读）"
    real score_before "提交前 MRC 分数"
    real score_after "提交后 MRC 分数"
    text rule_version_id FK "评分所用规则版本"
    text summary "变更摘要"
    time created_at "创建时间"
  }
  version_item {
    text id PK "变更项 ID"
    text version_id FK "所属版本"
    text target_kind "对象类型"
    text target_id "对象 ID"
    text change_kind "变更类型"
    json before_json "变更前状态（对象级差分）"
    json after_json "变更后状态"
    text diff_summary "人类可读差异摘要"
  }
  edit_session {
    text id PK "会话 ID"
    text project_id FK "所属工程"
    text start_version_id FK "会话起始版本"
    text end_version_id FK "会话结束版本"
    text app_version "软件版本"
    text machine_id "机器标识"
    time started_at "开始时间"
    time ended_at "结束时间"
    text exit_kind "退出方式"
    bool recovered "是否已恢复"
  }
  operation {
    text id PK "操作 ID"
    text session_id FK "所属会话"
    int seq "会话内序号（从 1 递增）"
    text op_type "操作类型"
    text target_kind "对象类型"
    text target_id "对象 ID"
    json payload_json "正向操作内容"
    json inverse_json "反向操作内容（撤销用）"
    hash inverse_blob_hash FK "反向操作过大时存 blob"
    text undo_of_op_id FK "撤销/重做指向的原操作"
    text version_id FK "该操作最终落入的版本"
    text author_kind "发起者类型"
    time created_at "发生时间"
  }
  snapshot {
    text id PK "快照 ID"
    text project_id FK "所属工程"
    text session_id FK "所属会话（scope=session 时必填）"
    text scope "快照用途"
    text version_id FK "对应版本（scope=version/backup）"
    int op_seq "快照覆盖到的操作序号"
    hash blob_hash FK "快照内容（CAS）"
    int byte_size "字节数"
    time created_at "生成时间"
  }
  blob {
    hash hash PK "sha256（小写十六进制）"
    text algo "摘要算法"
    text kind "内容类别"
    int byte_size "字节数"
    text rel_path "相对路径（blobs/ab/cd/<hash>）"
    int ref_count "引用计数（缓存值）"
    text verify_status "校验状态"
    time last_verified_at "最近校验时间"
    bool is_pinned "钉住（不参与 GC）"
    time gc_graced_until "GC 宽限截止"
    time created_at "写入时间"
  }
  blob_gc_log {
    text id PK "日志 ID"
    int scanned "扫描 blob 数"
    int deleted "实际删除数"
    int freed_bytes "释放字节数"
    bool dry_run "是否仅演练"
    json deleted_hashes_json "被删除的哈希清单"
    text note "说明（触发方式、宽限期）"
    time created_at "执行时间"
  }
  migration_log {
    text id PK "迁移 ID"
    text project_id FK "所属工程（空=全局迁移）"
    int from_schema "源模式版本"
    int to_schema "目标模式版本"
    hash backup_blob_hash FK "迁移前备份"
    text result "结果"
    json detail_json "逐表迁移明细与失败原因"
    time applied_at "执行时间"
  }
  external_file {
    text id PK "记录 ID"
    text project_id FK "所属工程"
    text role "文件角色"
    text path "文件路径（工程内相对或绝对）"
    int size_bytes "字节数"
    time mtime "文件修改时间"
    hash hash_at_import "导入时哈希"
    hash hash_last_seen "最近一次校验看到的哈希"
    text format "格式标识"
    text verify_status "校验状态"
    time imported_at "导入时间"
  }
  app_setting {
    text setting_key PK "设置键"
    json value_json "设置值（JSON）"
    text scope "作用域"
    time updated_at "修改时间"
  }
  structure {
    text id PK "结构 ID"
    text project_id FK "所属工程"
    text source_file_id FK "源 STEP 文件指纹"
    text step_schema "STEP 协议"
    text entity_kind "实体形态"
    bool flattened "装配体是否已展平"
    text unit_in "源文件单位"
    real unit_scale "到 mm 的换算系数"
    hash mesh_blob_hash FK "网格（CAS）"
    real mesh_tolerance_mm "网格容差（默认 0.02）"
    int triangle_count "三角面数"
    real bbox_min_x_mm "包围盒 X 最小"
    real bbox_min_y_mm "包围盒 Y 最小"
    real bbox_min_z_mm "包围盒 Z 最小"
    real bbox_max_x_mm "包围盒 X 最大"
    real bbox_max_y_mm "包围盒 Y 最大"
    real bbox_max_z_mm "包围盒 Z 最大"
    text import_status "导入状态"
    int import_ms "导入耗时（毫秒）"
    time imported_at "导入时间"
    time created_at "创建时间"
  }
  board_outline {
    text id PK "板框 ID"
    text structure_id FK "所属结构"
    text kind "来源方式"
    hash geometry_blob_hash FK "板框几何（CAS，折线点序）"
    real area_mm2 "面积（mm²）"
    bool is_valid "是否闭合有效"
    text note "说明/失败原因"
    time created_at "创建时间"
  }
  feature {
    text id PK "特征 ID"
    text structure_id FK "所属结构"
    text kind "加体或减体"
    text shape "体类型"
    json params_json "几何参数"
    hash preview_blob_hash FK "预览网格"
    text status "状态"
    int sort_order "排序号"
    text note "说明"
    time deleted_at "软删除时间"
    time created_at "创建时间"
  }
  bool_candidate {
    text id PK "候选 ID"
    text structure_id FK "所属结构"
    text op "运算"
    text shape "体类型"
    json params_json "候选参数（位置/尺寸/朝向）"
    hash preview_blob_hash FK "预览网格"
    text status "处置状态"
    text reject_reason "拒绝原因"
    time created_at "创建时间"
  }
  diagnostic {
    text id PK "诊断 ID"
    text project_id FK "所属工程"
    text scope "发生环节"
    text target_kind "对象类型"
    text target_id "对象 ID"
    text code "诊断码"
    text severity "严重度"
    text message "中文说明"
    json detail_json "上下文（数值、部位、建议）"
    int layer_no "层号（切片相关）"
    real x_mm "位置 X"
    real y_mm "位置 Y"
    time created_at "发生时间"
  }
  circuit {
    text id PK "电路 ID"
    text project_id FK "所属工程"
    text board_file_id FK "板文件指纹"
    text netlist_file_id FK "网表指纹（纯网表场景）"
    text coord_file_id FK "坐标表指纹（纯网表场景）"
    text source_format "源格式"
    text unit_in "源单位"
    real board_w_mm "板宽（mm）"
    real board_h_mm "板高（mm）"
    int component_count "器件数"
    int pad_count "焊盘数"
    int net_count "网络数"
    hash import_hash "导入结果摘要（复核数量一致性）"
    time imported_at "导入时间"
    time created_at "创建时间"
  }
  net_class {
    text id PK "网络类 ID"
    text circuit_id FK "所属电路"
    text name "名称（如 default/power/rf）"
    real min_width_mm "线宽下限（mm）"
    real min_spacing_mm "间距下限（mm）"
    text color "显示色（#RRGGBB）"
    text note "说明"
    time created_at "创建时间"
  }
  component {
    text id PK "器件 ID"
    text circuit_id FK "所属电路"
    text ref_des "位号（如 R1、U3）"
    text footprint "封装名"
    real x_mm "X 坐标（mm）"
    real y_mm "Y 坐标（mm）"
    int rot_deg "旋转角"
    text side "所在面"
    real height_mm "器件高度（mm）"
    real body_w_mm "本体宽（mm）"
    real body_h_mm "本体高（mm）"
    bool locked "锁定（禁止移动）"
    text net_class_id FK "所属网络类"
    text note "说明"
    time created_at "创建时间"
  }
  net {
    text id PK "网络 ID"
    text circuit_id FK "所属电路"
    text name "网络名"
    text net_class_id FK "网络类"
    bool is_power "电源网络标记"
    time created_at "创建时间"
  }
  pad {
    text id PK "焊盘 ID"
    text component_id FK "所属器件"
    text net_id FK "所属网络"
    text pad_no "焊盘编号"
    real x_mm "X（mm）"
    real y_mm "Y（mm）"
    real w_mm "焊盘宽"
    real h_mm "焊盘高"
    text shape "形状"
    text side "所在面"
    bool plated "是否金属化"
  }
  route {
    text id PK "走线 ID"
    text circuit_id FK "所属电路"
    text net_id FK "所属网络"
    int layer_no "层号（首版 0/1，预留）"
    text side "所在面"
    real width_mm "线宽（mm）"
    hash geom_blob_hash FK "折线点序（CAS，float32 x,y）"
    real length_mm "长度（mm）"
    int point_count "点数"
    real start_x_mm "起点 X"
    real start_y_mm "起点 Y"
    real end_x_mm "终点 X"
    real end_y_mm "终点 Y"
    real z_mm "Z 覆盖值（V1 用）"
    time deleted_at "软删除时间"
    time created_at "创建时间"
  }
  jumper {
    text id PK "跳线 ID"
    text circuit_id FK "所属电路"
    text net_id FK "所属网络"
    text pad_a_id FK "焊盘 A"
    text pad_b_id FK "焊盘 B"
    real resistance_ohm "等效电阻（0Ω）"
    text status "状态"
    time created_at "创建时间"
  }
  keepout {
    text id PK "禁布区 ID"
    text circuit_id FK "所属电路"
    text kind "形状"
    hash geometry_blob_hash FK "几何（CAS）"
    text applies_layer "作用层"
    text reason "来源说明"
    time created_at "创建时间"
  }
  copper_zone {
    text id PK "铺铜区 ID"
